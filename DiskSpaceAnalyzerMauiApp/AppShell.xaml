<?xml version="1.0" encoding="UTF-8"?>

<Shell
    x:Class="DiskSpaceAnalyzerMauiApp.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:local="clr-namespace:DiskSpaceAnalyzerMauiApp.Resources.Views"
    Shell.FlyoutBehavior="Disabled"
    Title="DSA">

    <ShellContent
        ContentTemplate="{DataTemplate local:AnalyzeSettingsPage}"
        Route="AnalyzeSettingsPage" />
    <ShellContent
        ContentTemplate="{DataTemplate local:AnalyzePage}"
        Route="AnalyzePage" />
    <ShellContent
        ContentTemplate="{DataTemplate local:InfoPage}"
        Route="InfoPage" />
</Shell>